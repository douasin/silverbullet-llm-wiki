# kb-audio 容器設定（NAS /volume1/docker/kb-audio/.env；密值只住這裡）
# 公用入口（給大家：轉逐字稿 + 摘要）：https://<node>.ts.net:8443/<AUDIO_PATH_SECRET>/
AUDIO_PATH_SECRET=
# kb 入口（給使用者：多背景欄位 + 匯入 kb）：https://<node>.ts.net:8443/<KB_PATH_SECRET>/
KB_PATH_SECRET=
# 轉寫走 OpenRouter /api/v1/audio/transcriptionsOPENROUTER_API_KEY=
# 摘要與匯入提議走 Anthropic Messages APIANTHROPIC_API_KEY=
# 橋的 MCP 端點（區網），含 MCP_PATH_SECRET
MCP_URL=http://<NAS-IP>:8008/<MCP_PATH_SECRET>/mcp
# 上傳上限(MB);公用入口 2 GB,kb 入口 0 = 不限
MAX_UPLOAD_MB=2048
KB_MAX_UPLOAD_MB=0
