# 複製成 .env 後填值;.env 不要進版控
# SilverBullet 位址(從 NAS 容器看出去;同一台就走 LAN IP 或 host 網路)
SB_URL=http://<NAS-IP>:3001
# SilverBullet 的 API token(= silverbullet/compose.yaml 的 SB_AUTH_TOKEN);有填就走 Bearer
SB_TOKEN=
# token 留空時的回退:帳密 cookie 登入。兩個變數必須存在,用 token 時值可隨意
SB_USER=admin
SB_PASSWORD=請填
# 以下三把各自獨立產生:python -c "import secrets;print(secrets.token_urlsafe(32))"
# MCP 端點路徑密鑰(必填,至少 16 字元):https://…/<MCP_PATH_SECRET>/mcp
MCP_PATH_SECRET=請填長隨機字串
# 分享頁 / 狀態頁 / 歷史頁的路徑密鑰;留空=這三個端點關閉
SHARE_SECRET=
# 協作端點(share: edit 的頁)的路徑密鑰;留空=關閉
ALLY_SECRET=
# 選填:額外的 Bearer 驗證(claude.ai connector 不支援自訂 header,留空即可;
# 若日後有能帶 header 的客戶端再啟用)
MCP_BEARER_TOKEN=
PORT=8008
# 容器直接講 TLS(router 直通、不走反向代理的部署用):
# 把憑證放進本資料夾的 certs/ 後填 /certs/fullchain.pem 與 /certs/privkey.pem。
# 走 Tailscale Funnel 時兩行留空(TLS 由 Funnel 終結)
SSL_CERTFILE=
SSL_KEYFILE=
